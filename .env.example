# BloodBank Application Environment Configuration Template
# Copy this file to .env or set environment variables in your terminal.
# NEVER commit your real MySQL database password.

DB_URL=jdbc:mysql://localhost:3306/bloodbank_db?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD
SERVER_PORT=8080

# Real Email Notification Settings (Optional / Configurable)
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=YOUR_APP_PASSWORD
MAIL_FROM=your-email@example.com
BLOODBANK_ADMIN_EMAIL=admin@example.com
MAIL_ELIGIBILITY_REMINDERS_ENABLED=false

