flowchart LR
    DonorActor["Donor"]
    StaffActor["Blood Bank Staff / Phlebotomist"]
    HospitalActor["Hospital / Doctor"]
    SchedulerActor["System Scheduler"]

    subgraph BloodBankSystem ["BloodBank Inventory & Donor Tracker"]
        UC1(["Register New Donor"])
        UC2(["Update Donor Profile"])
